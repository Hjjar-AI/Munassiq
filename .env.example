# Copy to .env; never commit .env. Generate a key as explained in README.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS_ONLY=false
# Enable only behind a local proxy which replaces X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false
APP_RUNTIME_DIR=runtime
APP_BIND=127.0.0.1:8000
