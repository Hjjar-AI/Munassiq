# Copy to .env; never commit .env. Generate a key as explained in README.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS_ONLY=false
# Enable only behind a loopback proxy replacing X-Forwarded-Proto and X-Real-IP.
DJANGO_TRUST_PROXY=false
APP_RUNTIME_DIR=runtime
APP_BIND=127.0.0.1:8000

# Browser origin used in bilingual account emails; replace for deployment.
APP_PUBLIC_URL=http://127.0.0.1:8000
PASSWORD_MIN_LENGTH=6
SESSION_DAYS=30
ACCESS_TOKEN_MINUTES=15
LOGIN_LIMIT=10
STAFF_LOGIN_LIMIT=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
ADMIN_IP_RESTRICTION=false
# CIDR networks; REMOTE_ADDR is checked, never a caller's forwarding header.
ADMIN_ALLOWED_NETWORKS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true

# Arabic-capable TrueType font for registrant PDF exports.
EXPORT_FONT_PATH=

# Delivery disabled until you configure Firebase. Keep the JSON key outside Git/media.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
ANNOUNCEMENTS_PER_ADMIN_PER_DAY=3
