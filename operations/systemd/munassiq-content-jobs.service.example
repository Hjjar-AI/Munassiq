[Unit]
Description=Munassiq content lifecycle jobs

[Service]
Type=oneshot
User=munassiq
WorkingDirectory=/absolute/path/munassiq
EnvironmentFile=/absolute/path/munassiq/.env
Environment=APP_LOG_NAME=content-jobs
ExecStart=/bin/bash /absolute/path/munassiq/operations/scripts/run_management.sh run_content_jobs
UMask=0077
NoNewPrivileges=true
